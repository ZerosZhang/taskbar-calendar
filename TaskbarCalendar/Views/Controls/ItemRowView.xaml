<UserControl x:Class="TaskbarCalendar.Views.Controls.ItemRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 勾选框 / 备忘实心圆 -->
        <Border x:Name="CheckArea"
                Grid.Column="0"
                Width="18"
                Height="18"
                Background="Transparent"
                Cursor="Hand"
                VerticalAlignment="Center"
                MouseLeftButtonDown="CheckArea_MouseLeftButtonDown">
            <Grid>
                <Border x:Name="MemoDot"
                        Width="6"
                        Height="6"
                        CornerRadius="3"
                        Background="#B6B9BF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                <CheckBox x:Name="DoneCheck"
                          Style="{StaticResource FieldCheckBox}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />
            </Grid>
        </Border>

        <WrapPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontSize="12.5"
                       Foreground="#2A2A2E"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Path x:Name="NoteIcon"
                  Width="11"
                  Height="11"
                  Margin="5,0,0,0"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Stroke="#9AA0A8"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Visibility="Collapsed"
                  Data="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 9H8 M16 13H8 M16 17H8" />
        </WrapPanel>

        <!-- 标签：重要 / 项目 / 周期 -->
        <Border x:Name="TagPill"
                Grid.Column="2"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                Padding="6,1"
                CornerRadius="4"
                Visibility="Collapsed"
                MouseLeftButtonDown="TagPill_MouseLeftButtonDown">
            <TextBlock x:Name="TagText" FontSize="10" />
        </Border>
    </Grid>
</UserControl>
