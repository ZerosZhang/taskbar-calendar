<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主题色板：界面里新增颜色时优先从这里取，避免各处写死色值 -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#3D7BFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E3ECFF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#1A4FD0" />

    <SolidColorBrush x:Key="Brush.Surface" Color="#F2F4F8" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E2E6EF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D8DCE3" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#E8EAF0" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5F6368" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8A8F98" />

    <SolidColorBrush x:Key="Brush.PriorityHigh" Color="#D93A3A" />
    <SolidColorBrush x:Key="Brush.PriorityMedium" Color="#C98A00" />
    <SolidColorBrush x:Key="Brush.PriorityLow" Color="#2E9E5B" />

    <SolidColorBrush x:Key="Brush.RowHover" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#332F6BFF" />
    <SolidColorBrush x:Key="Brush.RowHigh" Color="#2ED93A3A" />
    <SolidColorBrush x:Key="Brush.RowMedium" Color="#2EC98A00" />
    <SolidColorBrush x:Key="Brush.RowLow" Color="#2E2E9E5B" />

</ResourceDictionary>
