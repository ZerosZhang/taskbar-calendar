<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 本程序以 WPF 为主，DPI 感知必须写在清单里，WinForms 分析器建议不适用 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>TaskbarCalendar</AssemblyName>
    <RootNamespace>TaskbarCalendar</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

</Project>
